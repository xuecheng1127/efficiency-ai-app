<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务：后台持续计时（模块1 P0 计时器） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- T13b：闹钟响铃前台服务（mediaPlayback 类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 精确闹钟：任务提醒（模块1 闹钟系统，setExactAndAllowWhileIdle 必需） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 锁屏显示 / 全屏闹钟 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 勿扰模式（学习任务一键专注，V1.2 使用） -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- T11：开机重建闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 途径提醒：定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:label="效率助手"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T14：改为 exported=true，锁屏时 SystemUI 才能通过 setFullScreenIntent 拉起；
             Activity 内校验 intent.action 为 ACTION_ALARM，拒绝第三方拉起 -->
        <activity
            android:name=".alarm.AlarmFullScreenActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/AlarmFullScreenTheme"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <!-- 闹钟广播接收器（V1.2）：接收 AlarmManager 精确闹钟广播 →
             启动全屏响铃页；重复任务自动排下一次 -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- T12：精确闹钟权限变化重排 -->
        <receiver
            android:name=".alarm.ExactAlarmPermissionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- T11：开机重建闹钟。directBootAware=true 以便接收 LOCKED_BOOT_COMPLETED；
             但 credential-encrypted 存储在 unlock 前不可读，LOCKED_BOOT_COMPLETED 时降级跳过，
             真正重建在 BOOT_COMPLETED 执行。 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 前台服务：任务后台持续计时（模块1 P0，flutter_foreground_task 8.x）
             Android 14+ 必须声明 foregroundServiceType；计时属 dataSync 场景 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- T13b：闹钟响铃前台服务
             响铃由服务持有，Activity 被销毁不影响响铃
             foregroundServiceType=mediaPlayback：播放闹钟铃声场景 -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- A/B 归因测试 A 组：恢复 Impeller（移除 opt-out），只验证 addPostFrameCallback 修复 -->
    </application>
</manifest>
